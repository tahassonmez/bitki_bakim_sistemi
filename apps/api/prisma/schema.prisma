// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum PlantStatus {
  ACTIVE
  REMOVED
}

enum ProductType {
  FERTILIZER
  PESTICIDE
  OTHER
}

model Customer {
  id            String     @id @default(cuid())
  name          String
  address       String?
  phone         String?
  email         String?
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  locations     Location[]
  assignedStaff Staff[]    @relation("StaffCustomerAssignment")
}

model Location {
  id         String   @id @default(cuid())
  name       String
  // Google Places otomatik tamamlamadan seçilen adres ve koordinatlar —
  // seçim yapılmazsa boş kalabilir (düz metin adres girişine de izin verir).
  address    String?
  latitude   Float?
  longitude  Float?
  placeId    String?
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  plants     Plant[]
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model Staff {
  id                String           @id @default(cuid())
  fullName          String
  email             String           @unique
  phone             String?
  passwordHash      String
  role              Role             @default(STAFF)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  maintenanceLogs   MaintenanceLog[]
  assignedCustomers Customer[]       @relation("StaffCustomerAssignment")
  sentMessages      Message[]        @relation("SentMessages")
  receivedMessages  Message[]        @relation("ReceivedMessages")
  sentGroupMessages GroupMessage[]   @relation("SentGroupMessages")
  groupRead         GroupMessageRead?
}

model Plant {
  id                  String           @id @default(cuid())
  plantCode           String           @unique
  name                String
  species             String
  locationId          String
  location            Location         @relation(fields: [locationId], references: [id])
  potInfo             String?
  sizeInfo            String?
  registeredAt        DateTime         @default(now())
  careFrequencyDays   Int
  lastMaintenanceDate DateTime?
  nextMaintenanceDate DateTime?
  status              PlantStatus      @default(ACTIVE)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  maintenanceLogs     MaintenanceLog[]

  @@index([locationId])
  @@index([nextMaintenanceDate])
}

model MaintenanceType {
  id       String                 @id @default(cuid())
  name     String                 @unique
  isActive Boolean                @default(true)
  actions  MaintenanceLogAction[]
}

model Product {
  id            String                  @id @default(cuid())
  name          String
  type          ProductType
  unit          String?
  stockQuantity Float?
  notes         String?
  usages        MaintenanceLogProduct[]
}

model MaintenanceLog {
  id        String                  @id @default(cuid())
  plantId   String
  plant     Plant                   @relation(fields: [plantId], references: [id])
  staffId   String
  staff     Staff                   @relation(fields: [staffId], references: [id])
  date      DateTime                @default(now())
  notes     String?
  actions   MaintenanceLogAction[]
  products  MaintenanceLogProduct[]
  photos    Photo[]
  createdAt DateTime                @default(now())

  @@index([plantId])
  @@index([date])
}

model MaintenanceLogAction {
  id     String          @id @default(cuid())
  logId  String
  log    MaintenanceLog  @relation(fields: [logId], references: [id])
  typeId String
  type   MaintenanceType @relation(fields: [typeId], references: [id])

  @@unique([logId, typeId])
}

model MaintenanceLogProduct {
  id           String         @id @default(cuid())
  logId        String
  log          MaintenanceLog @relation(fields: [logId], references: [id])
  productId    String
  product      Product        @relation(fields: [productId], references: [id])
  quantityUsed Float?

  @@unique([logId, productId])
}

model Photo {
  id           String         @id @default(cuid())
  logId        String
  log          MaintenanceLog @relation(fields: [logId], references: [id])
  url          String
  uploadedById String
  createdAt    DateTime       @default(now())
}

model Message {
  id         String    @id @default(cuid())
  senderId   String
  sender     Staff     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   Staff     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  body       String?
  photoUrl   String?
  createdAt  DateTime  @default(now())
  readAt     DateTime?

  @@index([senderId, receiverId])
  @@index([receiverId, readAt])
}

// Tüm aktif personelin otomatik olarak içinde olduğu ortak (genel) sohbet
// odası. Üyelik ayrı bir tabloyla tutulmuyor — "isActive" olan her personel
// zaten otomatik olarak bu odanın bir parçası sayılıyor.
model GroupMessage {
  id        String   @id @default(cuid())
  senderId  String
  sender    Staff    @relation("SentGroupMessages", fields: [senderId], references: [id])
  body      String?
  photoUrl  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Her personelin ortak sohbeti en son ne zaman okuduğunu tutuyor; okunmamış
// sayısı bu tarihten sonra gönderilen (kendi göndermediği) mesajlar sayılarak
// hesaplanıyor.
model GroupMessageRead {
  staffId    String   @id
  staff      Staff    @relation(fields: [staffId], references: [id])
  lastReadAt DateTime @default(now())
}
